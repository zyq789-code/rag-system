# ===== 服务器部署专用 .env 模板 =====
# 用法：在服务器项目根目录 cp deploy/.env.example .env 后填入真实 Key
# 注意：与本地 .env 不同 —— 数据库/缓存/向量库用【容器服务名】而非 localhost！

# LLM
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 数据库（服务名 = docker-compose 中的服务名）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_system

# Redis
REDIS_URL=redis://redis:6379/0

# ChromaDB（容器内部端口 8000，不是宿主机映射的 8001）
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Embedding / 重排（大陆需离线，模型由 deploy/prepare_models.sh 预下）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=maidalun1020/bce-reranker-base_v1

# App
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_VECTOR=20
TOP_K_BM25=20
TOP_K_RERANK=5

# JWT 签名密钥（生产务必设为随机值，服务器上改完需重启 backend）
SECRET_KEY=change-me-in-production

# HuggingFace 离线加载（大陆节点必须，模型已由 prepare_models.sh 缓存在宿主）
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
